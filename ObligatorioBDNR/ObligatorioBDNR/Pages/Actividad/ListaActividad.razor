@page "/actividad"
@inject AuthService AuthService
@inject ActividadUsuarioRepository ActividadRepository
@inject UsuarioRepository UsuarioRepository
@inject NavigationManager Navigation

<PageTitle>Mi Actividad - Duolingo</PageTitle>

@if (!AuthService.EstaAutenticado())
{
    <div class="alert alert-warning">
        Debes iniciar sesión para ver tu actividad. <a href="/login">Iniciar Sesión</a>
    </div>
}
else if (usuario == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <h1>Mi Actividad</h1>

    <div class="mb-3">
        <p><strong>Usuario:</strong> @usuario.Username (@usuario.Email)</p>
        <a href="/" class="btn btn-secondary">Volver al Perfil</a>
    </div>

    @if (actividades == null)
    {
        <p><em>Cargando actividades...</em></p>
    }
    else if (!actividades.Any())
    {
        <div class="alert alert-info">
            Este usuario no tiene actividades registradas.
        </div>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label">Página:</label>
            <select class="form-select d-inline-block w-auto" @onchange="CambiarPagina">
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <option value="@i" selected="@(i == paginaActual)">@i</option>
                }
            </select>
            <span class="ms-2">Mostrando @((paginaActual - 1) * pageSize + 1) - @(Math.Min(paginaActual * pageSize, (int)totalRegistros)) de @totalRegistros</span>
        </div>

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Acciones</th>
                        <th>Total XP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var actividad in actividades)
                    {
                        <tr>
                            <td>@actividad.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (actividad.Acciones != null && actividad.Acciones.Any())
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var accion in actividad.Acciones)
                                        {
                                            <li>
                                                <span class="badge bg-info">@accion.Tipo</span>
                                                @if (accion.XpGanado > 0)
                                                {
                                                    <span class="text-success">+@accion.XpGanado XP</span>
                                                }
                                                <small class="text-muted">@accion.Timestamp.ToString("HH:mm")</small>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted">Sin acciones</span>
                                }
                            </td>
                            <td>
                                <strong>@(actividad.Acciones?.Sum(a => a.XpGanado) ?? 0) XP</strong>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private Usuario? usuario;
    private List<ActividadUsuario> actividades = new();
    private int paginaActual = 1;
    private int pageSize = 10;
    private long totalRegistros = 0;
    private int totalPaginas => (int)Math.Ceiling((double)totalRegistros / pageSize);

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaAutenticado())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        usuario = await AuthService.GetUsuarioActualAsync();
        if (usuario == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CargarActividades();
    }

    private async Task CargarActividades()
    {
        if (usuario == null) return;
        
        var resultado = await ActividadRepository.GetPagedByUsuarioAsync(usuario.Id, paginaActual, pageSize);
        actividades = resultado.actividades;
        totalRegistros = resultado.total;
    }

    private async Task CambiarPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var nuevaPagina))
        {
            paginaActual = nuevaPagina;
            await CargarActividades();
        }
    }
}

