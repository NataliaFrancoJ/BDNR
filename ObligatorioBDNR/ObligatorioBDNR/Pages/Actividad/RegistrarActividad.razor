@page "/actividad/registrar/{IdUsuario:guid}"
@inject ActividadUsuarioRepository ActividadRepository
@inject UsuarioRepository UsuarioRepository
@inject NavigationManager Navigation

<PageTitle>Registrar Actividad - Duolingo</PageTitle>

<h1>Registrar Nueva Actividad</h1>

@if (usuario == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="mb-3">
        <p><strong>Usuario:</strong> @usuario.Username (@usuario.Email)</p>
    </div>

    <EditForm Model="@actividadDTO" OnValidSubmit="@RegistrarActividadAsync">
        <DataAnnotationsValidator />
        
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Fecha *</label>
                    <InputDate @bind-Value="actividadDTO.Fecha" class="form-control" />
                    <ValidationMessage For="@(() => actividadDTO.Fecha)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Tipo de Acción *</label>
                    <InputSelect @bind-Value="actividadDTO.TipoAccion" class="form-select">
                        <option value="">-- Seleccione un tipo --</option>
                        <option value="Lección Completada">Lección Completada</option>
                        <option value="Práctica">Práctica</option>
                        <option value="Repaso">Repaso</option>
                        <option value="Desafío">Desafío</option>
                        <option value="Historia">Historia</option>
                        <option value="Ejercicio de Escritura">Ejercicio de Escritura</option>
                        <option value="Ejercicio de Pronunciación">Ejercicio de Pronunciación</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => actividadDTO.TipoAccion)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">ID de Lección</label>
                    <InputText @bind-Value="actividadDTO.IdLeccion" class="form-control" placeholder="Opcional" />
                </div>

                <div class="mb-3">
                    <label class="form-label">XP Ganado *</label>
                    <InputNumber @bind-Value="actividadDTO.XpGanado" class="form-control" />
                    <ValidationMessage For="@(() => actividadDTO.XpGanado)" />
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger">@mensajeError</div>
        }

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert alert-success">@mensajeExito</div>
        }

        <div class="mt-3">
            <button type="submit" class="btn btn-primary" disabled="@guardando">@(guardando ? "Guardando..." : "Registrar Actividad")</button>
            <a href="/actividad/@IdUsuario" class="btn btn-secondary">Cancelar</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid IdUsuario { get; set; }

    private Usuario? usuario;
    private ActividadDTO actividadDTO = new();
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private bool guardando = false;

    protected override async Task OnInitializedAsync()
    {
        usuario = await UsuarioRepository.GetByIdAsync(IdUsuario);
        actividadDTO.IdUsuario = IdUsuario;
        actividadDTO.Fecha = DateTime.Today;
    }

    private async Task RegistrarActividadAsync()
    {
        guardando = true;
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        try
        {
            // Buscar si ya existe una actividad para este usuario en esta fecha
            var actividadExistente = await ActividadRepository.GetByUsuarioAndDateAsync(IdUsuario, actividadDTO.Fecha);

            if (actividadExistente != null)
            {
                // Agregar la acción a la actividad existente
                actividadExistente.Acciones ??= new List<Accion>();
                actividadExistente.Acciones.Add(new Accion
                {
                    Tipo = actividadDTO.TipoAccion,
                    Timestamp = DateTime.Now,
                    IdLeccion = actividadDTO.IdLeccion,
                    XpGanado = actividadDTO.XpGanado
                });

                await ActividadRepository.UpdateAsync(actividadExistente.Id, actividadExistente);
            }
            else
            {
                // Crear nueva actividad
                var nuevaActividad = new ActividadUsuario
                {
                    Id = Guid.NewGuid(),
                    IdUsuario = IdUsuario,
                    Fecha = actividadDTO.Fecha.Date,
                    Acciones = new List<Accion>
                    {
                        new Accion
                        {
                            Tipo = actividadDTO.TipoAccion,
                            Timestamp = DateTime.Now,
                            IdLeccion = actividadDTO.IdLeccion,
                            XpGanado = actividadDTO.XpGanado
                        }
                    }
                };

                await ActividadRepository.InsertAsync(nuevaActividad);
            }

            mensajeExito = "Actividad registrada exitosamente.";
            
            await Task.Delay(1500);
            Navigation.NavigateTo($"/actividad/{IdUsuario}");
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al registrar actividad: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }
}

