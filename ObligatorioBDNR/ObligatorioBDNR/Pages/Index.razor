@page "/"
@page "/dashboard"
@inject AuthService AuthService
@inject UsuarioRepository UsuarioRepository
@inject LogroRepository LogroRepository
@inject ActividadUsuarioRepository ActividadRepository
@inject NavigationManager Navigation
@using System.Linq

<PageTitle>Mi Perfil - Duolingo</PageTitle>

@if (cargandoUsuario)
{
    <div class="container mt-5">
        <div class="text-center">
            <p><em>Cargando...</em></p>
        </div>
    </div>
}
else if (!AuthService.EstaAutenticado())
{
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-info text-center">
                    <h4>¡Bienvenido a Duolingo!</h4>
                    <p>Debes iniciar sesión para ver tu perfil.</p>
                    <a href="/login" class="btn btn-primary">Iniciar Sesión</a>
                    <a href="/registro" class="btn btn-success ms-2">Registrarse</a>
                </div>
            </div>
        </div>
    </div>
}
else if (usuario == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(usuario.FotoPerfil))
                    {
                        <img src="@usuario.FotoPerfil" alt="@usuario.Username" class="img-fluid rounded-circle mb-3" style="max-width: 150px;" />
                    }
                    else
                    {
                        <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3 text-white" style="width: 150px; height: 150px; font-size: 4rem;">
                            @usuario.Username[0].ToString().ToUpper()
                        </div>
                    }
                    <h2>@usuario.Username</h2>
                    <p class="text-muted">@usuario.Email</p>
                    <span class="badge @(usuario.Suscripcion?.Tipo == "Plus" ? "bg-success" : "bg-secondary") fs-6">
                        @(usuario.Suscripcion?.Tipo ?? "Gratis")
                    </span>
                    <div class="mt-3">
                        <a href="/perfil/editar" class="btn btn-warning">Editar Perfil</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="row mb-3">
                <div class="col-md-3">
                    <div class="card text-white bg-primary">
                        <div class="card-body text-center">
                            <h3>@(usuario.ProgresoGeneral?.XpTotal ?? 0)</h3>
                            <p class="mb-0">XP Total</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-success">
                        <div class="card-body text-center">
                            <h3>@(usuario.ProgresoGeneral?.NivelesCompletados ?? 0)</h3>
                            <p class="mb-0">Niveles</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-info">
                        <div class="card-body text-center">
                            <h3>@(usuario.Logros?.Count ?? 0)</h3>
                            <p class="mb-0">Logros</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-warning">
                        <div class="card-body text-center">
                            <h3>@(usuario.Amigos?.Count ?? 0)</h3>
                            <p class="mb-0">Amigos</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h3>Progreso</h3>
                </div>
                <div class="card-body">
                    <p><strong>Idioma Principal:</strong> @(usuario.ProgresoGeneral?.IdiomaPrincipal ?? "No especificado")</p>
                    <p><strong>XP Total:</strong> @(CalcularXpTotal(usuario))</p>
                    @if (usuario.EstadisticasGenerales != null)
                    {
                        <p><strong>Racha Actual:</strong> @usuario.EstadisticasGenerales.RachaActual días</p>
                    }
                </div>
            </div>

            @if (usuario.EstadisticasGenerales != null)
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <h3>Estadísticas Generales</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Racha Actual:</strong> @usuario.EstadisticasGenerales.RachaActual días</p>
                                <p><strong>Racha Máxima:</strong> @usuario.EstadisticasGenerales.RachaMaxima días</p>
                                <p><strong>Días Activos (últimos 30):</strong> @usuario.EstadisticasGenerales.DiasActivosUltimos30 días</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>XP Semana Actual:</strong> @usuario.EstadisticasGenerales.XpSemanaActual XP</p>
                                <p><strong>XP Semana Anterior:</strong> @usuario.EstadisticasGenerales.XpSemanaAnterior XP</p>
                                @if (usuario.EstadisticasGenerales.XpSemanaAnterior > 0)
                                {
                                    var diferencia = usuario.EstadisticasGenerales.XpSemanaActual - usuario.EstadisticasGenerales.XpSemanaAnterior;
                                    var porcentaje = (diferencia * 100.0) / usuario.EstadisticasGenerales.XpSemanaAnterior;
                                    <p>
                                        <strong>Comparación:</strong>
                                        <span class="@(diferencia >= 0 ? "text-success" : "text-danger")">
                                            @(diferencia >= 0 ? "+" : "")@diferencia XP (@(porcentaje >= 0 ? "+" : "")@porcentaje.ToString("F1")%)
                                        </span>
                                    </p>
                                }
                            </div>
                        </div>
                        <div class="mt-3">
                            <a href="/estadisticas" class="btn btn-primary">Ver Estadísticas Completas</a>
                        </div>
                    </div>
                </div>
            }

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3>Mis Cursos (@(usuario.Cursos?.Count ?? 0))</h3>
                    <a href="/cursos" class="btn btn-sm btn-primary">Gestionar Cursos</a>
                </div>
                <div class="card-body">
                    @if (usuario.Cursos != null && usuario.Cursos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Idioma</th>
                                        <th>Progreso</th>
                                        <th>XP Acumulado</th>
                                        <th>Unidades Completadas</th>
                                        <th>Fecha de Inscripción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var curso in usuario.Cursos)
                                    {
                                        <tr>
                                            <td><strong>@curso.Idioma</strong></td>
                                            <td>
                                                @if (curso.Unidades != null && curso.Unidades.Any())
                                                {
                                                    <a href="/cursos/@curso.Idioma" class="badge bg-info text-decoration-none">
                                                        Unidad @curso.UnidadActual, Nivel @curso.NivelActual
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Sin progreso</span>
                                                }
                                            </td>
                                            <td>@curso.XpAcumulado XP</td>
                                            <td>@curso.UnidadesCompletadas / @(curso.Unidades?.Count ?? 0)</td>
                                            <td>@curso.FechaInscripcion.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Aún no estás inscrito en ningún curso. <a href="/cursos">Inscríbete ahora</a></p>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h3>Mis Logros (@(usuario.Logros?.Count ?? 0))</h3>
                </div>
                <div class="card-body">
                    @if (usuario.Logros != null && usuario.Logros.Any())
                    {
                        <div class="row">
                            @foreach (var logro in usuario.Logros)
                            {
                                <div class="col-md-6 mb-2">
                                    <div class="border rounded p-2">
                                        <strong>@logro.Nombre</strong>
                                        <br />
                                        <small class="text-muted">Obtenido: @logro.FechaObtencion.ToString("dd/MM/yyyy")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Aún no has obtenido logros. ¡Sigue aprendiendo!</p>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h3>Mis Amigos (@(usuario.Amigos?.Count ?? 0))</h3>
                </div>
                <div class="card-body">
                    @if (usuario.Amigos != null && usuario.Amigos.Any())
                    {
                        <div class="row">
                            @foreach (var amigo in usuario.Amigos.GroupBy(a => a.IdUsuario).Select(g => g.First()))
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card border">
                                        <div class="card-body">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center text-white me-3" style="width: 50px; height: 50px; font-size: 1.5rem;">
                                                    @amigo.Username[0].ToString().ToUpper()
                                                </div>
                                                <div>
                                                    <h5 class="mb-0">@amigo.Username</h5>
                                                    <small class="text-muted">Amigo</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Aún no tienes amigos agregados. ¡Agrega amigos para competir y motivarte!</p>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h3>Actividad Reciente</h3>
                </div>
                <div class="card-body">
                    <a href="/actividad" class="btn btn-primary">Ver Mis Actividades</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Usuario? usuario;
    private List<LogroDefinicion> logrosDisponibles = new();
    private bool cargandoUsuario = true;

    protected override async Task OnInitializedAsync()
    {
        cargandoUsuario = true;
        
        // Dar tiempo para que la sesión se establezca después del login
        await Task.Delay(100);
        
        if (!AuthService.EstaAutenticado())
        {
            cargandoUsuario = false;
            return;
        }

        usuario = await AuthService.GetUsuarioActualAsync();
        if (usuario == null)
        {
            cargandoUsuario = false;
            // No redirigir automáticamente, solo mostrar el mensaje de bienvenida
            return;
        }

        // Recargar desde la base de datos para asegurar datos actualizados
        var usuarioId = AuthService.GetUsuarioIdActual();
        if (usuarioId.HasValue)
        {
            usuario = await UsuarioRepository.GetByIdAsync(usuarioId.Value);
        }

        logrosDisponibles = await LogroRepository.GetAllAsync();
        cargandoUsuario = false;
    }

    private int CalcularXpTotal(Usuario usuario)
    {
        if (usuario.Cursos != null && usuario.Cursos.Any())
        {
            return usuario.Cursos.Sum(c => c.XpAcumulado);
        }
        return 0;
    }

    private bool EsUsuarioPlus()
    {
        return usuario?.Suscripcion?.Tipo == "Plus";
    }
}

