@page "/logros"
@inject AuthService AuthService
@inject LogroRepository LogroRepository
@inject UsuarioRepository UsuarioRepository
@inject NavigationManager Navigation

<PageTitle>Logros Disponibles - Duolingo</PageTitle>

@if (!AuthService.EstaAutenticado())
{
    <div class="alert alert-warning">
        Debes iniciar sesión para ver los logros. <a href="/login">Iniciar Sesión</a>
    </div>
}
else
{
    <h1>Logros Disponibles</h1>

    @if (logros == null)
    {
        <p><em>Cargando...</em></p>
    }
    else if (!logros.Any())
    {
        <div class="alert alert-info">
            No hay logros disponibles.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var logro in logros)
            {
                var tieneLogro = usuario?.Logros?.Any(l => l.IdLogro == logro.Id) ?? false;
                <div class="col-md-4 mb-3">
                    <div class="card @(tieneLogro ? "border-success" : "")">
                        <div class="card-body">
                            <h5 class="card-title">
                                @logro.Nombre
                                @if (tieneLogro)
                                {
                                    <span class="badge bg-success">Obtenido</span>
                                }
                            </h5>
                            <p class="card-text">@logro.Descripcion</p>
                            <p class="text-muted">
                                <strong>Recompensa:</strong> <span class="badge bg-success">+@logro.XpRecompensa XP</span>
                            </p>
                            @if (tieneLogro && usuario != null)
                            {
                                var logroUsuario = usuario.Logros.First(l => l.IdLogro == logro.Id);
                                <small class="text-muted">Obtenido el: @logroUsuario.FechaObtencion.ToString("dd/MM/yyyy")</small>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private List<LogroDefinicion> logros = new();
    private Usuario? usuario;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaAutenticado())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        usuario = await AuthService.GetUsuarioActualAsync();
        if (usuario == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CargarLogros();
    }

    private async Task CargarLogros()
    {
        logros = await LogroRepository.GetAllAsync();
        // Recargar usuario para obtener logros actualizados
        usuario = await AuthService.GetUsuarioActualAsync();
    }
}

