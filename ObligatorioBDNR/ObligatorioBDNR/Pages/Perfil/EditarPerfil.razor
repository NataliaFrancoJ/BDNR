@page "/perfil/editar"
@inject AuthService AuthService
@inject UsuarioRepository UsuarioRepository
@inject NavigationManager Navigation

<PageTitle>Editar Perfil - Duolingo</PageTitle>

@if (!AuthService.EstaAutenticado())
{
    <div class="alert alert-warning">
        Debes iniciar sesión para editar tu perfil. <a href="/login">Iniciar Sesión</a>
    </div>
}
else if (usuario == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <h1>Editar Mi Perfil</h1>

    <EditForm Model="@usuarioDTO" OnSubmit="@ActualizarPerfil">
        <DataAnnotationsValidator />
        
        <div class="row">
            <div class="col-md-6">
                <h3>Información Básica</h3>
                
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText @bind-Value="usuarioDTO.Email" class="form-control" />
                    <ValidationMessage For="@(() => usuarioDTO.Email)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <InputText @bind-Value="usuarioDTO.Username" class="form-control" />
                    <ValidationMessage For="@(() => usuarioDTO.Username)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nueva Contraseña (dejar vacío para no cambiar)</label>
                    <InputText type="password" @bind-Value="nuevaPassword" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Foto de Perfil (URL)</label>
                    <InputText @bind-Value="usuarioDTO.FotoPerfil" class="form-control" />
                </div>

            </div>

            <div class="col-md-6">
                <h3>Configuración de Privacidad</h3>
                
                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="usuarioDTO.PerfilVisible" class="form-check-input" />
                    <label class="form-check-label">Perfil Visible</label>
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="usuarioDTO.MostrarRacha" class="form-check-input" />
                    <label class="form-check-label">Mostrar Racha</label>
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="usuarioDTO.PermitirMensajes" class="form-check-input" />
                    <label class="form-check-label">Permitir Mensajes</label>
                </div>

                <div class="mb-3">
                    <label class="form-label">Compartir Actividad</label>
                    <InputSelect @bind-Value="usuarioDTO.CompartirActividad" class="form-select">
                        <option value="Nadie">Nadie</option>
                        <option value="Amigos">Amigos</option>
                        <option value="Todos">Todos</option>
                    </InputSelect>
                </div>

                <h3>Suscripción</h3>
                <div class="mb-3">
                    <label class="form-label">Tipo de Suscripción</label>
                    <InputSelect @bind-Value="usuarioDTO.TipoSuscripcion" class="form-select">
                        <option value="Gratis">Gratis</option>
                        <option value="Plus">Plus</option>
                    </InputSelect>
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="usuarioDTO.AutoRenovacion" class="form-check-input" />
                    <label class="form-check-label">Auto Renovación</label>
                </div>

                <h3>Notificaciones</h3>
                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="usuarioDTO.NotificacionesEmail" class="form-check-input" />
                    <label class="form-check-label">Notificaciones por Email</label>
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="usuarioDTO.NotificacionesPush" class="form-check-input" />
                    <label class="form-check-label">Notificaciones Push</label>
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="usuarioDTO.RecordatoriosDiarios" class="form-check-input" />
                    <label class="form-check-label">Recordatorios Diarios</label>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger">@mensajeError</div>
        }

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert alert-success">@mensajeExito</div>
        }

        <div class="mt-3">
            <button type="submit" class="btn btn-primary" disabled="@guardando">@(guardando ? "Guardando..." : "Guardar Cambios")</button>
            <a href="/" class="btn btn-secondary">Cancelar</a>
        </div>
    </EditForm>
}

@code {
    private Usuario? usuario;
    private UsuarioDTO usuarioDTO = new();
    private string nuevaPassword = string.Empty;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private bool guardando = false;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaAutenticado())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        usuario = await AuthService.GetUsuarioActualAsync();
        if (usuario == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CargarUsuario();
    }

    private async Task CargarUsuario()
    {
        if (usuario != null)
        {
            usuarioDTO = new UsuarioDTO
            {
                Email = usuario.Email,
                Username = usuario.Username,
                FotoPerfil = usuario.FotoPerfil ?? string.Empty,
                Tiene2FA = usuario.Autenticacion?.Tiene2FA ?? false,
                Metodo2FA = usuario.Autenticacion?.Metodo2FA ?? string.Empty,
                PerfilVisible = usuario.ConfiguracionPrivacidad?.PerfilVisible ?? true,
                MostrarRacha = usuario.ConfiguracionPrivacidad?.MostrarRacha ?? true,
                PermitirMensajes = usuario.ConfiguracionPrivacidad?.PermitirMensajes ?? true,
                CompartirActividad = usuario.ConfiguracionPrivacidad?.CompartirActividad ?? "Amigos",
                IdiomaPrincipal = usuario.ProgresoGeneral?.IdiomaPrincipal ?? "Español",
                NivelesCompletados = usuario.ProgresoGeneral?.NivelesCompletados ?? 0,
                XpTotal = usuario.ProgresoGeneral?.XpTotal ?? 0,
                TipoSuscripcion = usuario.Suscripcion?.Tipo ?? "Gratis",
                AutoRenovacion = usuario.Suscripcion?.AutoRenovacion ?? false,
                IdiomasInteres = usuario.Preferencias?.IdiomasInteres ?? new List<string>(),
                NotificacionesEmail = usuario.Preferencias?.Notificaciones?.Email ?? true,
                NotificacionesPush = usuario.Preferencias?.Notificaciones?.Push ?? true,
                RecordatoriosDiarios = usuario.Preferencias?.Notificaciones?.RecordatoriosDiarios ?? true
            };
        }
    }

    private async Task ActualizarPerfil(EditContext editContext)
    {
        // Mensaje de depuración
        mensajeError = "Iniciando actualización...";
        guardando = true;
        mensajeExito = string.Empty;
        StateHasChanged();
        await Task.Delay(100); // Pequeño delay para que se vea el mensaje

        try
        {
            // Validar el formulario manualmente
            if (!editContext.Validate())
            {
                var errores = string.Join(", ", editContext.GetValidationMessages());
                mensajeError = $"Errores de validación: {errores}";
                guardando = false;
                StateHasChanged();
                return;
            }
            
            mensajeError = string.Empty; // Limpiar mensaje de depuración

            if (usuario == null)
            {
                mensajeError = "Usuario no encontrado.";
                guardando = false;
                StateHasChanged();
                return;
            }

            var usuarioId = AuthService.GetUsuarioIdActual();
            if (!usuarioId.HasValue || usuarioId.Value != usuario.Id)
            {
                mensajeError = "No tienes permiso para editar este perfil.";
                guardando = false;
                StateHasChanged();
                return;
            }

            // Verificar si el email ya existe en otro usuario
            var usuarioConEmail = await UsuarioRepository.GetByEmailAsync(usuarioDTO.Email);
            if (usuarioConEmail != null && usuarioConEmail.Id != usuario.Id)
            {
                mensajeError = "Ya existe otro usuario con este email.";
                guardando = false;
                StateHasChanged();
                return;
            }

            // Verificar si el username ya existe en otro usuario
            var usuarioConUsername = await UsuarioRepository.GetByUsernameAsync(usuarioDTO.Username);
            if (usuarioConUsername != null && usuarioConUsername.Id != usuario.Id)
            {
                mensajeError = "Ya existe otro usuario con este username.";
                guardando = false;
                StateHasChanged();
                return;
            }

            // Actualizar el usuario
            usuario.Email = usuarioDTO.Email;
            usuario.Username = usuarioDTO.Username;
            usuario.FotoPerfil = usuarioDTO.FotoPerfil;

            if (!string.IsNullOrEmpty(nuevaPassword))
            {
                usuario.Autenticacion ??= new Autenticacion();
                usuario.Autenticacion.PasswordHash = BCrypt.Net.BCrypt.HashPassword(nuevaPassword);
            }

            usuario.Autenticacion ??= new Autenticacion();
            usuario.Autenticacion.Tiene2FA = usuarioDTO.Tiene2FA;
            usuario.Autenticacion.Metodo2FA = usuarioDTO.Metodo2FA;

            usuario.ConfiguracionPrivacidad = new ConfiguracionPrivacidad
            {
                PerfilVisible = usuarioDTO.PerfilVisible,
                MostrarRacha = usuarioDTO.MostrarRacha,
                PermitirMensajes = usuarioDTO.PermitirMensajes,
                CompartirActividad = usuarioDTO.CompartirActividad
            };

            // Mantener los valores originales de ProgresoGeneral (no se pueden editar)
            // Calcular XP total basado en los cursos
            usuario.ProgresoGeneral = new ProgresoGeneral
            {
                IdiomaPrincipal = usuario.ProgresoGeneral?.IdiomaPrincipal ?? "Español",
                NivelesCompletados = usuario.ProgresoGeneral?.NivelesCompletados ?? 0,
                XpTotal = CalcularXpTotal(usuario)
            };

            usuario.Suscripcion = new Suscripcion
            {
                Tipo = usuarioDTO.TipoSuscripcion,
                FechaInicio = usuario.Suscripcion?.FechaInicio ?? (usuarioDTO.TipoSuscripcion == "Plus" ? DateTime.UtcNow : null),
                FechaFin = usuario.Suscripcion?.FechaFin ?? (usuarioDTO.TipoSuscripcion == "Plus" ? DateTime.UtcNow.AddMonths(1) : null),
                AutoRenovacion = usuarioDTO.AutoRenovacion
            };

            usuario.Preferencias = new Preferencias
            {
                IdiomasInteres = usuarioDTO.IdiomasInteres,
                Notificaciones = new Notificaciones
                {
                    Email = usuarioDTO.NotificacionesEmail,
                    Push = usuarioDTO.NotificacionesPush,
                    RecordatoriosDiarios = usuarioDTO.RecordatoriosDiarios
                }
            };

            // Asegurarse de que el ID del usuario se mantiene
            usuario.Id = usuarioId.Value;
            
            // Guardar el email antes de actualizar para verificar
            var emailAntes = usuario.Email;
            var emailDespues = usuarioDTO.Email;
            
            var resultado = await UsuarioRepository.UpdateAsync(usuario.Id, usuario);
            
            if (resultado)
            {
                // Verificar que realmente se actualizó en la base de datos
                var usuarioVerificado = await UsuarioRepository.GetByIdAsync(usuario.Id);
                
                // También verificar buscando por el nuevo email
                var usuarioPorEmail = await UsuarioRepository.GetByEmailAsync(emailDespues);
                
                if (usuarioVerificado != null && usuarioVerificado.Email == emailDespues && usuarioPorEmail != null)
                {
                    mensajeExito = "Perfil actualizado correctamente";
                    usuario = usuarioVerificado;
                    await CargarUsuario();
                }
                else
                {
                    mensajeError = $"Error: El email no se actualizó correctamente. " +
                                   $"Email esperado: {emailDespues}, " +
                                   $"Email en BD (por ID): {usuarioVerificado?.Email ?? "null"}, " +
                                   $"Usuario encontrado por email: {(usuarioPorEmail != null ? "Sí" : "No")}";
                    guardando = false;
                    StateHasChanged();
                    return;
                }
                
                StateHasChanged();
                
                // Esperar un momento antes de redirigir para que el usuario vea el mensaje
                await Task.Delay(2000);
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                mensajeError = "No se pudo actualizar el perfil. Por favor, intenta nuevamente.";
                guardando = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al actualizar perfil: {ex.Message}";
            guardando = false;
            StateHasChanged();
        }
    }

    private int CalcularXpTotal(Usuario usuario)
    {
        if (usuario.Cursos != null && usuario.Cursos.Any())
        {
            return usuario.Cursos.Sum(c => c.XpAcumulado);
        }
        return 0;
    }
}

