@page "/usuarios/detalle/{Id:guid}"
@inject UsuarioRepository UsuarioRepository
@inject ActividadUsuarioRepository ActividadRepository

<PageTitle>Detalle Usuario - Duolingo</PageTitle>

<h1>Perfil de Usuario</h1>

@if (usuario == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(usuario.FotoPerfil))
                    {
                        <img src="@usuario.FotoPerfil" alt="@usuario.Username" class="img-fluid rounded-circle mb-3" style="max-width: 150px;" />
                    }
                    else
                    {
                        <div class="bg-secondary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 150px; height: 150px;">
                            <span class="text-white fs-1">@usuario.Username[0]</span>
                        </div>
                    }
                    <h2>@usuario.Username</h2>
                    <p class="text-muted">@usuario.Email</p>
                    <span class="badge @(usuario.Suscripcion?.Tipo == "Plus" ? "bg-success" : "bg-secondary") fs-6">
                        @(usuario.Suscripcion?.Tipo ?? "Gratis")
                    </span>
                    <div class="mt-3">
                        <a href="/usuarios/editar/@usuario.Id" class="btn btn-warning">Editar</a>
                        <a href="/usuarios" class="btn btn-secondary">Volver</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header">
                    <h3>Progreso General</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <h4>@(usuario.ProgresoGeneral?.XpTotal ?? 0)</h4>
                            <p class="text-muted">XP Total</p>
                        </div>
                        <div class="col-md-4">
                            <h4>@(usuario.ProgresoGeneral?.NivelesCompletados ?? 0)</h4>
                            <p class="text-muted">Niveles Completados</p>
                        </div>
                        <div class="col-md-4">
                            <h4>@(usuario.ProgresoGeneral?.IdiomaPrincipal ?? "N/A")</h4>
                            <p class="text-muted">Idioma Principal</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h3>Logros Obtenidos (@(usuario.Logros?.Count ?? 0))</h3>
                </div>
                <div class="card-body">
                    @if (usuario.Logros != null && usuario.Logros.Any())
                    {
                        <div class="row">
                            @foreach (var logro in usuario.Logros)
                            {
                                <div class="col-md-6 mb-2">
                                    <div class="border rounded p-2">
                                        <strong>@logro.Nombre</strong>
                                        <br />
                                        <small class="text-muted">Obtenido: @logro.FechaObtencion.ToString("dd/MM/yyyy")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Este usuario aún no ha obtenido logros.</p>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h3>Amigos (@(usuario.Amigos?.Count ?? 0))</h3>
                </div>
                <div class="card-body">
                    @if (usuario.Amigos != null && usuario.Amigos.Any())
                    {
                        <ul class="list-group">
                            @foreach (var amigo in usuario.Amigos)
                            {
                                <li class="list-group-item">
                                    <a href="/usuarios/detalle/@amigo.IdUsuario">@amigo.Username</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">Este usuario aún no tiene amigos.</p>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h3>Configuración de Privacidad</h3>
                </div>
                <div class="card-body">
                    <p><strong>Perfil Visible:</strong> @(usuario.ConfiguracionPrivacidad?.PerfilVisible == true ? "Sí" : "No")</p>
                    <p><strong>Mostrar Racha:</strong> @(usuario.ConfiguracionPrivacidad?.MostrarRacha == true ? "Sí" : "No")</p>
                    <p><strong>Permitir Mensajes:</strong> @(usuario.ConfiguracionPrivacidad?.PermitirMensajes == true ? "Sí" : "No")</p>
                    <p><strong>Compartir Actividad:</strong> @(usuario.ConfiguracionPrivacidad?.CompartirActividad ?? "N/A")</p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h3>Actividad Reciente</h3>
                </div>
                <div class="card-body">
                    <a href="/actividad/@usuario.Id" class="btn btn-primary">Ver Todas las Actividades</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Usuario? usuario;

    protected override async Task OnInitializedAsync()
    {
        usuario = await UsuarioRepository.GetByIdAsync(Id);
    }
}

