@inject AuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Duolingo</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        @if (estaAutenticado)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    Mi Perfil
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="perfil/editar">
                    Editar Perfil
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="logros">
                    Ver Logros
                </NavLink>
            </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="cursos">
                        Mis Cursos
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="estadisticas">
                        Estadísticas
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <a class="nav-link" href="/auth/logout" @onclick="CerrarSesion" @onclick:preventDefault>
                        Cerrar Sesión
                    </a>
                </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    Iniciar Sesión
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="registro">
                    Registrarse
                </NavLink>
            </div>
        }
    </nav>
</div>

    @code {
        private string username = "";
        private bool estaAutenticado = false;
        private bool esPlus = false;

        protected override async Task OnInitializedAsync()
        {
            Navigation.LocationChanged += OnLocationChanged;
            await ActualizarEstado();
        }

        private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        {
            await ActualizarEstado();
        }

        private async Task ActualizarEstado()
        {
            estaAutenticado = AuthService.EstaAutenticado();
            if (estaAutenticado)
            {
                var usuario = await AuthService.GetUsuarioActualAsync();
                username = usuario?.Username ?? "";
                esPlus = usuario?.Suscripcion?.Tipo == "Plus";
            }
            else
            {
                username = "";
                esPlus = false;
            }
            StateHasChanged();
        }

    private void CerrarSesion()
    {
        // Redirigir a la página de logout que limpiará las cookies y sesión
        Navigation.NavigateTo("/auth/logout", forceLoad: true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}

